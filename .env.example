# --- Transcript source (Financial Modeling Prep) ---
# Free tier covers a handful of tickers/quarters; sign up at financialmodelingprep.com
FMP_API_KEY=your_fmp_key_here

# --- LLM providers (set the one you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=                      # only if your OpenAI-compatible server needs one

# --- Defaults (override per-run via CLI) ---
LLM_PROVIDER=anthropic            # anthropic | openai | gemini | openai-compatible
LLM_MODEL=                        # required for gemini and openai-compatible; overrides the two below when set
LLM_BASE_URL=                     # openai-compatible only, e.g. http://localhost:11434/v1
LLM_STRUCTURED=json               # json (any model) | native (Anthropic tool use / OpenAI structured outputs)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # bulk pass
OPENAI_MODEL=gpt-4o-mini

# Cache directory (transcripts + LLM responses)
CACHE_DIR=./cache
